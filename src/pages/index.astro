---
const title = "Lynk - Your Personal Link Hub";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
		<style>
			* {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			}

			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.fade-in-up {
				animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
			}

			.delay-1 { animation-delay: 0.1s; opacity: 0; }
			.delay-2 { animation-delay: 0.2s; opacity: 0; }
			.delay-3 { animation-delay: 0.3s; opacity: 0; }
			.delay-4 { animation-delay: 0.4s; opacity: 0; }
		</style>
	</head>
	<body class="bg-black text-white overflow-x-hidden">
		<!-- Navigation -->
		<nav class="fixed top-0 w-full z-50 border-b border-zinc-800 bg-black/80 backdrop-blur-sm">
			<div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">
				<div class="text-2xl font-black tracking-tight">LYNK</div>
				<div class="flex gap-6">
					<a href="/login" class="text-sm font-semibold text-gray-400 hover:text-white transition-colors">
						Login
					</a>
					<a href="/register" class="px-6 py-2 bg-lime-400 text-black rounded-lg text-sm font-black uppercase tracking-wide hover:bg-lime-300 transition-colors">
						Sign Up
					</a>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="min-h-screen flex items-center justify-center px-6 pt-20">
			<div class="max-w-6xl mx-auto text-center">
				<h1 class="text-7xl md:text-9xl font-black mb-8 tracking-tighter fade-in-up">
					ONE LINK<br />
					<span class="text-lime-400">INFINITE</span><br />
					REACH
				</h1>
				
				<p class="text-xl md:text-2xl text-gray-400 mb-12 max-w-3xl mx-auto fade-in-up delay-1">
					Share your entire digital presence with a single, powerful link. Built for creators, entrepreneurs, and anyone who wants to stand out.
				</p>

				<div class="flex flex-col sm:flex-row gap-6 justify-center mb-20 fade-in-up delay-2">
					<a href="/register" class="px-10 py-5 bg-lime-400 text-black rounded-xl font-black text-lg uppercase tracking-wide hover:bg-lime-300 transition-all hover:scale-105">
						Get Started Free
					</a>
					<a href="#features" class="px-10 py-5 border-2 border-zinc-800 rounded-xl font-black text-lg uppercase tracking-wide hover:border-lime-400 transition-all">
						Learn More
					</a>
				</div>

				<!-- Demo Preview -->
				<div class="relative fade-in-up delay-3">
					<div class="bg-zinc-900 border-2 border-zinc-800 rounded-3xl p-8 max-w-2xl mx-auto">
						<div class="flex items-center gap-2 mb-8">
							<div class="w-3 h-3 rounded-full bg-red-500"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500"></div>
							<div class="w-3 h-3 rounded-full bg-green-500"></div>
						</div>
						<div class="bg-black rounded-2xl p-8 text-left">
							<div class="flex items-center gap-4 mb-8">
								<div class="w-20 h-20 rounded-full bg-gradient-to-br from-lime-400 to-emerald-500"></div>
								<div>
									<div class="text-2xl font-black">@yourname</div>
									<div class="text-gray-500">Your awesome bio here</div>
								</div>
							</div>
							<div class="space-y-3">
								<div class="bg-zinc-900 border-2 border-zinc-800 rounded-xl p-4 hover:border-lime-400 transition-colors cursor-pointer">
									<div class="font-bold">🌐 Website</div>
								</div>
								<div class="bg-zinc-900 border-2 border-zinc-800 rounded-xl p-4 hover:border-lime-400 transition-colors cursor-pointer">
									<div class="font-bold">📱 Instagram</div>
								</div>
								<div class="bg-zinc-900 border-2 border-zinc-800 rounded-xl p-4 hover:border-lime-400 transition-colors cursor-pointer">
									<div class="font-bold">🎵 Spotify</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section id="features" class="py-32 px-6 border-t border-zinc-800">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-6xl md:text-8xl font-black text-center mb-20 tracking-tighter">
					WHY <span class="text-lime-400">LYNK</span>?
				</h2>

				<div class="grid md:grid-cols-3 gap-8">
					<div class="bg-zinc-900 border-2 border-zinc-800 rounded-3xl p-10 hover:border-lime-400 transition-all group">
						<div class="text-6xl mb-6">⚡</div>
						<h3 class="text-2xl font-black mb-4 uppercase tracking-wide">Lightning Fast</h3>
						<p class="text-gray-400 leading-relaxed">Built with Astro for blazing fast performance. Your links load instantly, every time.</p>
					</div>

					<div class="bg-zinc-900 border-2 border-zinc-800 rounded-3xl p-10 hover:border-purple-400 transition-all group">
						<div class="text-6xl mb-6">🎨</div>
						<h3 class="text-2xl font-black mb-4 uppercase tracking-wide">Bold Design</h3>
						<p class="text-gray-400 leading-relaxed">Stand out with stunning themes and customization options that match your brand.</p>
					</div>

					<div class="bg-zinc-900 border-2 border-zinc-800 rounded-3xl p-10 hover:border-pink-400 transition-all group">
						<div class="text-6xl mb-6">📊</div>
						<h3 class="text-2xl font-black mb-4 uppercase tracking-wide">Analytics</h3>
						<p class="text-gray-400 leading-relaxed">Track clicks, views, and engagement with detailed analytics and insights.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-32 px-6 border-t border-zinc-800">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-6xl md:text-8xl font-black mb-8 tracking-tighter">
					READY TO<br />
					<span class="text-lime-400">STAND OUT</span>?
				</h2>
				<p class="text-xl text-gray-400 mb-12">
					Join thousands of creators sharing their links with Lynk
				</p>
				<a href="/register" class="inline-block px-12 py-6 bg-lime-400 text-black rounded-xl font-black text-xl uppercase tracking-wide hover:bg-lime-300 transition-all hover:scale-105">
					Create Your Lynk
				</a>
			</div>
		</section>

		<!-- Footer -->
		<footer class="border-t border-zinc-800 py-12 px-6">
			<div class="max-w-6xl mx-auto text-center">
				<div class="text-2xl font-black mb-4 tracking-tight">LYNK</div>
				<p class="text-gray-600 text-sm">© 2026 Lynk. All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>

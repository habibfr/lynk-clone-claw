---
import { Zap, Link2, BarChart3, Sparkles, ArrowRight, Check } from '@lucide/astro';
const title = "Lynk - Your Personal Link Hub";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
		<style>
			* {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			}

			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes float {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-20px); }
			}

			.fade-in-up {
				animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
			}

			.float {
				animation: float 6s ease-in-out infinite;
			}

			.delay-1 { animation-delay: 0.1s; opacity: 0; }
			.delay-2 { animation-delay: 0.2s; opacity: 0; }
			.delay-3 { animation-delay: 0.3s; opacity: 0; }
			.delay-4 { animation-delay: 0.4s; opacity: 0; }

			.gradient-text {
				background: linear-gradient(135deg, #84cc16 0%, #10b981 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
		</style>
	</head>
	<body class="bg-black text-white overflow-x-hidden">
		<!-- Navigation -->
		<nav class="fixed top-0 w-full z-50 border-b border-zinc-800 bg-black/80 backdrop-blur-sm">
			<div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">
				<div class="text-2xl font-black tracking-tight flex items-center gap-2">
					<Link2 size={28} class="text-lime-400" />
					LYNK
				</div>
				<div class="flex gap-6">
					<a href="/login" class="text-sm font-semibold text-gray-400 hover:text-white transition-colors">
						Login
					</a>
					<a href="/register" class="px-6 py-2 bg-lime-400 text-black rounded-lg text-sm font-black uppercase tracking-wide hover:bg-lime-300 transition-colors inline-flex items-center gap-2">
						Sign Up
						<ArrowRight size={16} />
					</a>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="min-h-screen flex items-center justify-center px-6 pt-20">
			<div class="max-w-6xl mx-auto text-center">
				<div class="inline-flex items-center gap-2 px-4 py-2 bg-lime-400/10 border border-lime-400/20 rounded-full mb-8 fade-in-up">
					<Sparkles size={16} class="text-lime-400" />
					<span class="text-sm font-bold text-lime-400">Built for Creators</span>
				</div>

				<h1 class="text-7xl md:text-9xl font-black mb-8 tracking-tighter fade-in-up delay-1">
					ONE LINK<br />
					<span class="gradient-text">INFINITE</span><br />
					REACH
				</h1>
				
				<p class="text-xl md:text-2xl text-gray-400 mb-12 max-w-3xl mx-auto fade-in-up delay-2">
					Share your entire digital presence with a single, powerful link. Built for creators, entrepreneurs, and anyone who wants to stand out.
				</p>

				<div class="flex flex-col sm:flex-row gap-6 justify-center mb-20 fade-in-up delay-3">
					<a href="/register" class="px-10 py-5 bg-lime-400 text-black rounded-xl font-black text-lg uppercase tracking-wide hover:bg-lime-300 transition-all hover:scale-105 inline-flex items-center justify-center gap-3">
						Get Started Free
						<ArrowRight size={24} />
					</a>
					<a href="#features" class="px-10 py-5 border-2 border-zinc-800 rounded-xl font-black text-lg uppercase tracking-wide hover:border-lime-400 transition-all inline-flex items-center justify-center gap-3">
						Learn More
					</a>
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section id="features" class="py-32 px-6">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-20">
					<h2 class="text-5xl md:text-7xl font-black mb-6 tracking-tight">
						Everything You Need
					</h2>
					<p class="text-xl text-gray-400 max-w-2xl mx-auto">
						Powerful features designed to help you grow your audience and track your success.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8">
					<!-- Feature 1 -->
					<div class="bg-zinc-900 border-2 border-zinc-800 rounded-3xl p-8 hover:border-lime-400 transition-all group">
						<div class="w-16 h-16 bg-lime-400/10 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-lime-400/20 transition-colors">
							<Zap size={32} class="text-lime-400" />
						</div>
						<h3 class="text-2xl font-black mb-4">Lightning Fast</h3>
						<p class="text-gray-400 leading-relaxed">
							Built with Astro for blazing fast performance. Your links load instantly, keeping your audience engaged.
						</p>
					</div>

					<!-- Feature 2 -->
					<div class="bg-zinc-900 border-2 border-zinc-800 rounded-3xl p-8 hover:border-lime-400 transition-all group">
						<div class="w-16 h-16 bg-purple-500/10 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-purple-500/20 transition-colors">
							<Link2 size={32} class="text-purple-400" />
						</div>
						<h3 class="text-2xl font-black mb-4">Unlimited Links</h3>
						<p class="text-gray-400 leading-relaxed">
							Add as many links as you want. No limits, no restrictions. Share everything that matters.
						</p>
					</div>

					<!-- Feature 3 -->
					<div class="bg-zinc-900 border-2 border-zinc-800 rounded-3xl p-8 hover:border-lime-400 transition-all group">
						<div class="w-16 h-16 bg-pink-500/10 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-pink-500/20 transition-colors">
							<BarChart3 size={32} class="text-pink-400" />
						</div>
						<h3 class="text-2xl font-black mb-4">Track Analytics</h3>
						<p class="text-gray-400 leading-relaxed">
							See how your links perform. Track clicks, understand your audience, and grow smarter.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Stats Section -->
		<section class="py-32 px-6 border-y border-zinc-800">
			<div class="max-w-7xl mx-auto">
				<div class="grid md:grid-cols-3 gap-12 text-center">
					<div>
						<div class="text-6xl font-black mb-4 gradient-text">∞</div>
						<div class="text-xl font-bold text-gray-400">Unlimited Links</div>
					</div>
					<div>
						<div class="text-6xl font-black mb-4 gradient-text">⚡</div>
						<div class="text-xl font-bold text-gray-400">Lightning Fast</div>
					</div>
					<div>
						<div class="text-6xl font-black mb-4 gradient-text">🔒</div>
						<div class="text-xl font-bold text-gray-400">Secure & Private</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-32 px-6">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-5xl md:text-7xl font-black mb-8 tracking-tight">
					Ready to Get Started?
				</h2>
				<p class="text-xl text-gray-400 mb-12 max-w-2xl mx-auto">
					Join thousands of creators who trust Lynk to share their digital presence.
				</p>
				<a href="/register" class="inline-flex items-center gap-3 px-12 py-6 bg-lime-400 text-black rounded-xl font-black text-xl uppercase tracking-wide hover:bg-lime-300 transition-all hover:scale-105">
					Create Your Lynk
					<ArrowRight size={24} />
				</a>
			</div>
		</section>

		<!-- Footer -->
		<footer class="border-t border-zinc-800 py-12 px-6">
			<div class="max-w-7xl mx-auto text-center">
				<div class="flex items-center justify-center gap-2 mb-4">
					<Link2 size={24} class="text-lime-400" />
					<div class="text-2xl font-black">LYNK</div>
				</div>
				<p class="text-gray-600 text-sm">
					© 2026 Lynk. Built with Astro & Tailwind CSS.
				</p>
			</div>
		</footer>
	</body>
</html>

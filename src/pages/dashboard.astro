---
const title = "Dashboard - Lynk";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
		<style>
			* {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			}
			.line-clamp-2 {
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
		</style>
	</head>
	<body class="bg-black text-white min-h-screen">
		<!-- Navigation -->
		<nav class="border-b border-zinc-800">
			<div class="max-w-6xl mx-auto px-6 py-5 flex justify-between items-center">
				<a href="/" class="text-2xl font-black tracking-tight">LYNK</a>
				<div class="flex items-center gap-8">
					<a href="/settings" class="text-sm font-semibold text-gray-400 hover:text-lime-400 transition-colors">
						Settings
					</a>
					<a id="profileLink" href="#" class="text-sm font-semibold text-gray-400 hover:text-lime-400 transition-colors">
						<span id="username"></span>
					</a>
					<button id="logoutBtn" class="text-sm font-semibold text-gray-400 hover:text-red-400 transition-colors">
						Logout
					</button>
				</div>
			</div>
		</nav>

		<div class="max-w-5xl mx-auto px-6 py-16">
			<!-- Header -->
			<div class="mb-16">
				<h1 class="text-6xl font-black mb-3 tracking-tight">Dashboard</h1>
				<p class="text-gray-400 text-lg">Manage your links and track performance</p>
			</div>

			<!-- Stats -->
			<div class="grid md:grid-cols-3 gap-6 mb-16">
				<div class="bg-zinc-900 border-2 border-zinc-800 rounded-2xl p-8">
					<div class="text-sm font-bold text-gray-500 mb-2 uppercase tracking-wider">Total Links</div>
					<div class="text-5xl font-black text-lime-400" id="totalLinks">0</div>
				</div>
				<div class="bg-zinc-900 border-2 border-zinc-800 rounded-2xl p-8">
					<div class="text-sm font-bold text-gray-500 mb-2 uppercase tracking-wider">Profile Views</div>
					<div class="text-5xl font-black text-purple-400">0</div>
				</div>
				<div class="bg-zinc-900 border-2 border-zinc-800 rounded-2xl p-8">
					<div class="text-sm font-bold text-gray-500 mb-2 uppercase tracking-wider">Total Clicks</div>
					<div class="text-5xl font-black text-pink-400" id="totalClicks">0</div>
				</div>
			</div>

			<!-- Links Section -->
			<div class="bg-zinc-900 border-2 border-zinc-800 rounded-2xl p-10">
				<div class="flex justify-between items-center mb-10">
					<h2 class="text-3xl font-black">Your Links</h2>
					<button id="addLinkBtn" class="px-8 py-3 bg-lime-400 text-black rounded-xl text-sm font-black uppercase tracking-wide hover:bg-lime-300 transition-colors">
						Add Link
					</button>
				</div>
				
				<div id="linksContainer" class="space-y-4">
					<!-- Links will be loaded here -->
				</div>

				<div id="emptyState" class="text-center py-20 text-gray-600 hidden">
					<p class="text-2xl font-bold mb-2">No links yet</p>
					<p class="text-sm">Click "Add Link" to create your first link</p>
				</div>
			</div>
		</div>

		<!-- Add/Edit Link Modal -->
		<div id="linkModal" class="fixed inset-0 bg-black/90 backdrop-blur-sm hidden items-center justify-center z-50 p-4 overflow-y-auto">
			<div class="bg-zinc-900 border-2 border-zinc-800 rounded-2xl p-10 max-w-2xl w-full my-8">
				<h3 id="modalTitle" class="text-3xl font-black mb-8">Add Link</h3>
				<form id="linkForm" class="space-y-6">
					<input type="hidden" id="linkId" />
					
					<!-- Image Upload -->
					<div>
						<label class="block text-sm font-bold text-gray-400 mb-3 uppercase tracking-wider">Link Image (Optional)</label>
						<div class="flex gap-4 items-start">
							<div id="imagePreview" class="w-32 h-32 bg-black border-2 border-zinc-800 rounded-xl flex items-center justify-center overflow-hidden flex-shrink-0">
								<span class="text-gray-600 text-sm text-center px-2">No image</span>
							</div>
							<div class="flex-1">
								<input
									type="file"
									id="linkImage"
									accept="image/*"
									class="hidden"
								/>
								<button
									type="button"
									id="uploadImageBtn"
									class="px-6 py-3 border-2 border-zinc-800 rounded-xl font-bold uppercase tracking-wide hover:border-lime-400 transition-all text-sm mb-2 w-full"
								>
									Upload Image
								</button>
								<p class="text-xs text-gray-600 font-medium">Max 5MB. JPG, PNG, GIF, WebP</p>
								<input type="hidden" id="imageUrl" />
							</div>
						</div>
					</div>

					<div>
						<label class="block text-sm font-bold text-gray-400 mb-3 uppercase tracking-wider">Title</label>
						<input
							type="text"
							id="linkTitle"
							required
							class="w-full px-5 py-3 rounded-xl bg-black border-2 border-zinc-800 text-white focus:outline-none focus:border-lime-400 transition-colors"
							placeholder="My Website"
						/>
					</div>

					<div>
						<label class="block text-sm font-bold text-gray-400 mb-3 uppercase tracking-wider">URL</label>
						<input
							type="url"
							id="linkUrl"
							required
							class="w-full px-5 py-3 rounded-xl bg-black border-2 border-zinc-800 text-white focus:outline-none focus:border-lime-400 transition-colors"
							placeholder="https://example.com"
						/>
					</div>

					<div>
						<label class="block text-sm font-bold text-gray-400 mb-3 uppercase tracking-wider">Description (Optional)</label>
						<textarea
							id="linkDescription"
							rows="3"
							maxlength="200"
							class="w-full px-5 py-3 rounded-xl bg-black border-2 border-zinc-800 text-white focus:outline-none focus:border-lime-400 transition-colors resize-none"
							placeholder="Brief description of this link..."
						></textarea>
						<p class="text-xs text-gray-600 mt-2 font-medium"><span id="descCount">0</span>/200 characters</p>
					</div>

					<div>
					<div id="modalError" class="hidden bg-red-900/50 border-2 border-red-500 text-red-200 px-5 py-3 rounded-xl text-sm font-semibold"></div>

					<div class="flex gap-4 pt-4">
						<button
							type="submit"
							class="flex-1 px-8 py-3 bg-lime-400 text-black rounded-xl font-black uppercase tracking-wide hover:bg-lime-300 transition-colors"
						>
							Save
						</button>
						<button
							type="button"
							id="cancelBtn"
							class="px-8 py-3 border-2 border-zinc-800 rounded-xl font-black uppercase tracking-wide hover:bg-zinc-800 transition-colors"
						>
							Cancel
						</button>
					</div>
				</form>
			</div>
		</div>

		<script>
			const token = localStorage.getItem('token');
			const user = localStorage.getItem('user');

			if (!token || !user) {
				window.location.href = '/login';
			}

			const userData = JSON.parse(user!);
			const usernameEl = document.getElementById('username');
			const profileLink = document.getElementById('profileLink');
			if (usernameEl) usernameEl.textContent = `@${userData.username}`;
			if (profileLink) profileLink.href = `/u/${userData.username}`;

			// Logout
			document.getElementById('logoutBtn')?.addEventListener('click', () => {
				localStorage.removeItem('token');
				localStorage.removeItem('user');
				window.location.href = '/';
			});

			// Load links
			let links: any[] = [];
			let currentPage = 1;
			const linksPerPage = 2;

			async function loadLinks() {
				try {
					const response = await fetch('/api/links', {
						headers: { 'Authorization': `Bearer ${token}` }
					});

					if (response.ok) {
						const data = await response.json();
						links = data.links;
						renderLinks();
						updateStats();
					}
				} catch (error) {
					console.error('Load links error:', error);
				}
			}

			function renderLinks() {
				const container = document.getElementById('linksContainer');
				const emptyState = document.getElementById('emptyState');

				if (!container || !emptyState) return;

				if (links.length === 0) {
					container.innerHTML = '';
					emptyState.classList.remove('hidden');
					return;
				}

				emptyState.classList.add('hidden');
				
				// Calculate pagination
				const totalPages = Math.ceil(links.length / linksPerPage);
				const startIndex = (currentPage - 1) * linksPerPage;
				const endIndex = startIndex + linksPerPage;
				const paginatedLinks = links.slice(startIndex, endIndex);
				
				// Render links
				container.innerHTML = paginatedLinks.map(link => `
					<div class="bg-black border-2 border-zinc-800 rounded-2xl overflow-hidden hover:border-lime-400 transition-colors group">
						${link.image_url ? `
							<div class="relative h-32 overflow-hidden">
								<img src="${link.image_url}" alt="${link.title}" class="w-full h-full object-cover" />
								<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
								<div class="absolute top-3 right-3">
									<button onclick="toggleActive(${link.id}, ${link.is_active})" class="px-3 py-1.5 text-xs font-bold ${link.is_active ? 'bg-lime-400 text-black' : 'bg-zinc-800 text-gray-400'} rounded-lg hover:scale-105 transition-all">
										${link.is_active ? 'Active' : 'Inactive'}
									</button>
								</div>
							</div>
						` : `
							<div class="p-6 pb-0">
								<div class="flex justify-end mb-2">
									<button onclick="toggleActive(${link.id}, ${link.is_active})" class="px-3 py-1.5 text-xs font-bold ${link.is_active ? 'bg-lime-400 text-black' : 'bg-zinc-800 text-gray-400'} rounded-lg hover:scale-105 transition-all">
										${link.is_active ? 'Active' : 'Inactive'}
									</button>
								</div>
							</div>
						`}
						
						<div class="p-6 ${!link.image_url ? 'pt-0' : ''}">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="flex-1 min-w-0">
									<h3 class="font-black text-white text-xl mb-2">${link.title}</h3>
									${link.description ? `<p class="text-sm text-gray-400 mb-3 line-clamp-2">${link.description}</p>` : ''}
									<div class="text-sm text-gray-500 truncate">${link.url}</div>
								</div>
								<div class="flex flex-col items-end gap-2 flex-shrink-0">
									<div class="text-sm font-bold text-gray-500 whitespace-nowrap">${link.clicks} clicks</div>
								</div>
							</div>
							
							<div class="flex items-center justify-between gap-3 pt-4 border-t border-zinc-800">
								<div class="flex gap-2">
									<button onclick="editLink(${link.id})" class="px-4 py-2 text-sm font-bold text-gray-400 hover:text-lime-400 hover:bg-zinc-800 rounded-lg transition-all">
										Edit
									</button>
									<button onclick="deleteLink(${link.id})" class="px-4 py-2 text-sm font-bold text-gray-400 hover:text-red-400 hover:bg-zinc-800 rounded-lg transition-all">
										Delete
									</button>
								</div>
								<a href="${link.url}" target="_blank" class="p-2 bg-lime-400 text-black rounded-lg hover:bg-lime-300 transition-all">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6" />
									</svg>
								</a>
							</div>
						</div>
					</div>
				`).join('');

				// Render pagination
				if (totalPages > 1) {
					container.innerHTML += `
						<div class="flex items-center justify-center gap-3 pt-8">
							<button 
								onclick="changePage(${currentPage - 1})" 
								${currentPage === 1 ? 'disabled' : ''}
								class="px-4 py-2 border-2 border-zinc-800 rounded-lg text-sm font-bold hover:border-lime-400 transition-all disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:border-zinc-800"
							>
								←
							</button>
							
							<div class="flex gap-2">
								${Array.from({length: totalPages}, (_, i) => i + 1).map(page => `
									<button 
										onclick="changePage(${page})"
										class="w-10 h-10 rounded-lg text-sm font-bold ${page === currentPage ? 'bg-lime-400 text-black' : 'border-2 border-zinc-800 text-white hover:border-lime-400'} transition-all"
									>
										${page}
									</button>
								`).join('')}
							</div>
							
							<button 
								onclick="changePage(${currentPage + 1})" 
								${currentPage === totalPages ? 'disabled' : ''}
								class="px-4 py-2 border-2 border-zinc-800 rounded-lg text-sm font-bold hover:border-lime-400 transition-all disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:border-zinc-800"
							>
								→
							</button>
						</div>
					`;
				}
			}
			
			(window as any).changePage = (page: number) => {
				const totalPages = Math.ceil(links.length / linksPerPage);
				if (page < 1 || page > totalPages) return;
				currentPage = page;
				renderLinks();
				// Scroll to top of links
				document.getElementById('linksContainer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			};

			function updateStats() {
				const totalLinksEl = document.getElementById('totalLinks');
				const totalClicksEl = document.getElementById('totalClicks');

				if (totalLinksEl) totalLinksEl.textContent = links.length.toString();
				if (totalClicksEl) {
					const totalClicks = links.reduce((sum, link) => sum + link.clicks, 0);
					totalClicksEl.textContent = totalClicks.toString();
				}
			}

			// Modal
			const modal = document.getElementById('linkModal');
			const modalTitle = document.getElementById('modalTitle');
			const linkForm = document.getElementById('linkForm') as HTMLFormElement;
			const modalError = document.getElementById('modalError');
			const imagePreview = document.getElementById('imagePreview');
			const linkImageInput = document.getElementById('linkImage') as HTMLInputElement;
			const uploadImageBtn = document.getElementById('uploadImageBtn');
			const imageUrlInput = document.getElementById('imageUrl') as HTMLInputElement;

			// Description counter
			const descTextarea = document.getElementById('linkDescription') as HTMLTextAreaElement;
			const descCount = document.getElementById('descCount');

			descTextarea?.addEventListener('input', () => {
				if (descCount) {
					descCount.textContent = descTextarea.value.length.toString();
				}
			});

			// Image upload
			uploadImageBtn?.addEventListener('click', () => {
				linkImageInput?.click();
			});

			linkImageInput?.addEventListener('change', async () => {
				const file = linkImageInput.files?.[0];
				if (!file) return;

				// Validate file size
				if (file.size > 5 * 1024 * 1024) {
					const modalError = document.getElementById('modalError');
					if (modalError) {
						modalError.textContent = '❌ File too large! Maximum size is 5MB.';
						modalError.classList.remove('hidden');
					}
					linkImageInput.value = '';
					return;
				}

				// Validate file type
				const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
				if (!allowedTypes.includes(file.type)) {
					const modalError = document.getElementById('modalError');
					if (modalError) {
						modalError.textContent = '❌ Invalid file type! Only JPG, PNG, GIF, and WebP are allowed.';
						modalError.classList.remove('hidden');
					}
					linkImageInput.value = '';
					return;
				}

				// Show preview
				const reader = new FileReader();
				reader.onload = (e) => {
					if (imagePreview) {
						imagePreview.innerHTML = `<img src="${e.target?.result}" class="w-full h-full object-cover" />`;
					}
				};
				reader.readAsDataURL(file);

				// Show uploading state
				const uploadBtn = document.getElementById('uploadImageBtn');
				if (uploadBtn) {
					uploadBtn.textContent = 'Uploading...';
					uploadBtn.setAttribute('disabled', 'true');
				}

				// Upload
				const formData = new FormData();
				formData.append('file', file);

				try {
					const response = await fetch('/api/upload/link-image', {
						method: 'POST',
						headers: { 'Authorization': `Bearer ${token}` },
						body: formData
					});

					if (response.ok) {
						const data = await response.json();
						imageUrlInput.value = data.url;
						
						// Show success
						const modalError = document.getElementById('modalError');
						if (modalError) {
							modalError.textContent = '✅ Image uploaded successfully!';
							modalError.classList.remove('hidden');
							modalError.classList.remove('bg-red-900/50', 'border-red-500', 'text-red-200');
							modalError.classList.add('bg-green-900/50', 'border-green-500', 'text-green-200');
							
							setTimeout(() => {
								modalError.classList.add('hidden');
								modalError.classList.remove('bg-green-900/50', 'border-green-500', 'text-green-200');
								modalError.classList.add('bg-red-900/50', 'border-red-500', 'text-red-200');
							}, 2000);
						}
					} else {
						const data = await response.json();
						const modalError = document.getElementById('modalError');
						if (modalError) {
							modalError.textContent = `❌ Upload failed: ${data.error || 'Unknown error'}`;
							modalError.classList.remove('hidden');
						}
						
						// Reset preview
						if (imagePreview) {
							imagePreview.innerHTML = '<span class="text-gray-600 text-sm text-center px-2">No image</span>';
						}
					}
				} catch (error) {
					const modalError = document.getElementById('modalError');
					if (modalError) {
						modalError.textContent = '❌ Network error! Please check your connection and try again.';
						modalError.classList.remove('hidden');
					}
					
					// Reset preview
					if (imagePreview) {
						imagePreview.innerHTML = '<span class="text-gray-600 text-sm text-center px-2">No image</span>';
					}
				} finally {
					// Reset button
					if (uploadBtn) {
						uploadBtn.textContent = 'Upload Image';
						uploadBtn.removeAttribute('disabled');
					}
				}
			});

			document.getElementById('addLinkBtn')?.addEventListener('click', () => {
				if (modalTitle) modalTitle.textContent = 'Add Link';
				linkForm?.reset();
				(document.getElementById('linkId') as HTMLInputElement).value = '';
				imageUrlInput.value = '';
				if (imagePreview) imagePreview.innerHTML = '<span class="text-gray-600 text-sm text-center px-2">No image</span>';
				if (descCount) descCount.textContent = '0';
				modal?.classList.remove('hidden');
				modal?.classList.add('flex');
			});

			document.getElementById('cancelBtn')?.addEventListener('click', () => {
				modal?.classList.add('hidden');
				modal?.classList.remove('flex');
			});

			(window as any).editLink = (id: number) => {
				const link = links.find(l => l.id === id);
				if (!link) return;

				if (modalTitle) modalTitle.textContent = 'Edit Link';
				(document.getElementById('linkId') as HTMLInputElement).value = id.toString();
				(document.getElementById('linkTitle') as HTMLInputElement).value = link.title;
				(document.getElementById('linkUrl') as HTMLInputElement).value = link.url;
				(document.getElementById('linkDescription') as HTMLTextAreaElement).value = link.description || '';
				imageUrlInput.value = link.image_url || '';
				
				if (descCount) descCount.textContent = (link.description || '').length.toString();

				if (imagePreview) {
					if (link.image_url) {
						imagePreview.innerHTML = `<img src="${link.image_url}" class="w-full h-full object-cover" />`;
					} else {
						imagePreview.innerHTML = '<span class="text-gray-600 text-sm text-center px-2">No image</span>';
					}
				}
				
				modal?.classList.remove('hidden');
				modal?.classList.add('flex');
			};

			(window as any).toggleActive = async (id: number, currentStatus: boolean) => {
				const newStatus = !currentStatus;
				const action = newStatus ? 'activate' : 'deactivate';
				
				if (!confirm(`Are you sure you want to ${action} this link?`)) return;
				
				try {
					const link = links.find(l => l.id === id);
					if (!link) return;
					
					const response = await fetch(`/api/links/${id}`, {
						method: 'PUT',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': `Bearer ${token}`
						},
						body: JSON.stringify({
							title: link.title,
							url: link.url,
							description: link.description,
							image_url: link.image_url,
							is_active: newStatus
						})
					});
					
					if (response.ok) {
						await loadLinks();
					}
				} catch (error) {
					console.error('Toggle active error:', error);
				}
			};
			
			(window as any).deleteLink = async (id: number) => {
				if (!confirm('Are you sure you want to delete this link?')) return;

				try {
					const response = await fetch(`/api/links/${id}`, {
						method: 'DELETE',
						headers: { 'Authorization': `Bearer ${token}` }
					});

					if (response.ok) {
						await loadLinks();
					}
				} catch (error) {
					console.error('Delete link error:', error);
				}
			};

			linkForm?.addEventListener('submit', async (e) => {
				e.preventDefault();

				const linkId = (document.getElementById('linkId') as HTMLInputElement).value;
				const title = (document.getElementById('linkTitle') as HTMLInputElement).value;
				const url = (document.getElementById('linkUrl') as HTMLInputElement).value;
				const description = (document.getElementById('linkDescription') as HTMLTextAreaElement).value;
				// Icon removed
				const image_url = imageUrlInput.value;

				const isEdit = !!linkId;
				const endpoint = isEdit ? `/api/links/${linkId}` : '/api/links';
				const method = isEdit ? 'PUT' : 'POST';

				try {
					const response = await fetch(endpoint, {
						method,
						headers: {
							'Content-Type': 'application/json',
							'Authorization': `Bearer ${token}`
						},
						body: JSON.stringify({ 
							title, 
							url, 
							description: description || null,
							// icon removed
							image_url: image_url || null,
							is_active: true 
						})
					});

					if (response.ok) {
						modal?.classList.add('hidden');
						modal?.classList.remove('flex');
						await loadLinks();
					} else {
						const data = await response.json();
						if (modalError) {
							modalError.textContent = data.error || 'Failed to save link';
							modalError.classList.remove('hidden');
						}
					}
				} catch (error) {
					if (modalError) {
						modalError.textContent = 'Network error. Please try again.';
						modalError.classList.remove('hidden');
					}
				}
			});

